# --- Core Flask ---
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database ---
DATABASE_URL=


# --- Uploads ---
MAX_CONTENT_LENGTH_MB=50
UPLOAD_FOLDER=data/uploads
PROCESSED_FOLDER=data/processed
MODELS_FOLDER=data/models
REPORTS_FOLDER=data/reports

# --- Email (Flask-Mail) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@ai-analytics.local

# --- Security tokens ---
EMAIL_VERIFICATION_SALT=email-verification-salt
PASSWORD_RESET_SALT=password-reset-salt
EMAIL_TOKEN_MAX_AGE_SECONDS=86400
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=3600

# --- Rate limiting (Flask-Limiter) ---
RATELIMIT_STORAGE_URI=memory://
AUTH_RATE_LIMIT=10 per minute
UPLOAD_RATE_LIMIT=20 per minute
AI_RATE_LIMIT=20 per minute
ML_TRAIN_RATE_LIMIT=5 per minute

# --- AI Provider Selection ---
AI_PROVIDER=gemini
AI_PROVIDER_ORDER=gemini,groq,openrouter,claude

# --- Gemini (multi-key rotation) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-1.5-flash

# --- Other AI providers (added later without code changes) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AI usage limits ---
AI_DAILY_REQUEST_LIMIT_PER_USER=100
AI_MONTHLY_REQUEST_LIMIT_PER_USER=2000

# --- Admin bootstrap (optional, for first-run convenience) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
